
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMaster() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'allan_jamieson@outlook.com';
    }

    function hasAdminRole() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isMaster() || hasAdminRole();
    }

    // --- Explicit Scoping for Professional Audit Data ---

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Nested Explicit Match for Provable Safety in Collection Listing
      match /measurements/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /siteSummaries/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /siteReports/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Fallback for profile-level fields
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
